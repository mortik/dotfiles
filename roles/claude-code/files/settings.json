  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name // \"\"'); dir=$(basename \"$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd // \".\"')\"); p=$(grep -E '^(APP_)?PORT=' .env.local 2>/dev/null | head -1 | cut -d= -f2 | tr -d '\"'); out=\"$model · $dir\"; [ -n \"$p\" ] && out=\"$out · http://localhost:$p\"; printf '%s' \"$out\""
  },
